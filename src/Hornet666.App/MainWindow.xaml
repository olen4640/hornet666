<Window x:Class="Hornet666.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Шершень666 — Density Screener"
        Height="720" Width="1180" MinHeight="560" MinWidth="900"
        Background="#151719" Foreground="#F3F4F5"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="ШЕРШЕНЬ666" FontSize="25" FontWeight="Bold" Foreground="#E5B928"/>
                <TextBlock Text="DENSITY SCREENER  /  MOEX" FontSize="11" Foreground="#AAB1B7" Margin="1,2,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#493A12" CornerRadius="4" Padding="10,6" VerticalAlignment="Center">
                <TextBlock Text="DEMO DATA · NO LIVE FEED" FontWeight="Bold" FontSize="11" Foreground="#FFD86A"/>
            </Border>
        </DockPanel>

        <Border Grid.Row="1" Background="#202326" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Фильтры:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <CheckBox x:Name="StableOnlyCheck" Content="Только устойчивые" IsChecked="True" Foreground="#F3F4F5" VerticalAlignment="Center" Margin="0,0,18,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
                <CheckBox x:Name="RoundOnlyCheck" Content="Круглые / полукруглые" Foreground="#F3F4F5" VerticalAlignment="Center" Margin="0,0,18,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
                <TextBlock Text="Мин. объём:" Foreground="#AAB1B7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="MinVolumeBox" Text="1000" Width="82" Padding="5,3" Background="#303438" Foreground="White" BorderBrush="#555B60" TextChanged="FilterChanged"/>
                <Button Content="Сбросить" Click="ResetFilters_Click" Margin="12,0,0,0" Padding="12,5" Background="#3A3F43" Foreground="White" BorderThickness="0"/>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="DensityGrid" Grid.Row="2" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" RowBackground="#202326" AlternatingRowBackground="#292D30"
                  Background="#202326" Foreground="#F3F4F5" BorderBrush="#34393D"
                  HorizontalGridLinesBrush="#34393D" VerticalGridLinesBrush="#34393D"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Инструмент" Binding="{Binding Symbol}" Width="1.2*"/>
                <DataGridTextColumn Header="Сторона" Binding="{Binding Side}" Width="0.8*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=N2}" Width="*"/>
                <DataGridTextColumn Header="Объём" Binding="{Binding Volume, StringFormat=N0}" Width="*"/>
                <DataGridTextColumn Header="Дистанция, т." Binding="{Binding DistanceTicks, StringFormat=N1}" Width="*"/>
                <DataGridTextColumn Header="Смещение, т." Binding="{Binding PriceShiftTicks, StringFormat=N1}" Width="*"/>
                <DataGridTextColumn Header="Возраст, сек" Binding="{Binding AgeSeconds}" Width="*"/>
                <DataGridTextColumn Header="Касания" Binding="{Binding Touches}" Width="*"/>
                <DataGridTextColumn Header="Устойчивость" Binding="{Binding StabilityLabel}" Width="*"/>
                <DataGridTextColumn Header="Круглый уровень" Binding="{Binding RoundLabel}" Width="*"/>
                <DataGridTextColumn Header="Поведение" Binding="{Binding Behavior}" Width="1.3*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="CountText" Foreground="#AAB1B7" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right" Text="Фильтр №1: неподвижность заявки  →  Фильтр №2: ценовая разметка" Foreground="#AAB1B7" FontSize="11" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
